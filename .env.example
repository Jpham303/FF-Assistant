# Copy to .env and fill in. .env is gitignored and must never be committed.

# Ports on this computer (change any that clash with something already running)
API_PORT=8000
DAGSTER_PORT=3300
POSTGRES_HOST_PORT=5433

# Postgres (app data)
POSTGRES_USER=ffa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ffa
DATABASE_URL=postgresql+psycopg://ffa:change-me@postgres:5432/ffa

# Analytics warehouse (Parquet + DuckDB)
WAREHOUSE_DIR=/data/warehouse
MODELS_DIR=/data/models

# Sleeper (public API, no key needed)
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=

# Yahoo Fantasy API — create a free app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_LEAGUE_KEY=
